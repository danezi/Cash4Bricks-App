# ---------------------------------------------------------------------------
# Kopie als `.env` anlegen und Werte eintragen. `.env` wird von Git ignoriert.
#
# Nur Variablen mit dem Prefix EXPO_PUBLIC_ landen im App-Bundle. Sie sind im
# Client sichtbar -> KEINE Geheimnisse. Zugriff im Code nur ueber src/lib/env.ts.
# ---------------------------------------------------------------------------

# Adapter-Modus: mock (Default, In-Memory + Fixtures) oder supabase.
EXPO_PUBLIC_API_MODE=mock

# Logische Umgebung: development | preview | production.
EXPO_PUBLIC_ENV=development

# Supabase — nur im supabase-Modus erforderlich.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry — leer lassen -> Error-Monitoring deaktiviert.
EXPO_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Serverseitige Geheimnisse. NICHT hier setzen und NICHT committen.
# Gehoeren in Supabase- bzw. EAS-Secrets:
#   SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN   (Source-Map-Upload beim Build)
#   SUPABASE_SERVICE_ROLE_KEY                        (nur Edge Functions)
#   REBRICKABLE_API_KEY, BRICKSET_API_KEY, RESEND_API_KEY  (nur Edge Functions)
# ---------------------------------------------------------------------------
