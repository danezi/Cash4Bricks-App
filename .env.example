# Kopie als `.env` anlegen und Werte eintragen. `.env` wird von Git ignoriert.
# Nur Variablen mit dem Prefix EXPO_PUBLIC_ landen im App-Bundle (nicht geheim halten!).

# Sentry (Error-Monitoring). Leer lassen -> Monitoring deaktiviert.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ENV=development

# Nur für Source-Map-Upload beim EAS-Build (NICHT committen, kein EXPO_PUBLIC_):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
